<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent spacer for LinearLayout android:divider with showDividers="middle".
     Puts grid_spacing between items without per-item margins. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="@dimen/grid_spacing"
        android:height="@dimen/grid_spacing" />
    <solid android:color="@android:color/transparent" />
</shape>
