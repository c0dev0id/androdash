<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <include layout="@layout/dialog_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:divider="@drawable/divider_spacing"
        android:showDividers="middle">

        <!-- Shortcuts -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:divider="@drawable/divider_spacing"
            android:showDividers="middle">

            <TextView
                style="@style/Widget.Androdash.DialogLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shortcuts" />

            <ScrollView
                android:id="@+id/shortcutScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/shortcutContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@drawable/divider_spacing"
                    android:showDividers="middle" />

            </ScrollView>

            <TextView
                android:id="@+id/noShortcutsText"
                style="@style/Widget.Androdash.DialogButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_card_height"
                android:text="No shortcuts"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:divider="@drawable/divider_spacing"
            android:showDividers="middle">

            <TextView
                style="@style/Widget.Androdash.DialogLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hide app" />

            <TextView
                android:id="@+id/btnHideFromList"
                style="@style/Widget.Androdash.DialogButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_card_height" />

            <TextView
                android:id="@+id/btnHideFromHistory"
                style="@style/Widget.Androdash.DialogButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_card_height" />

            <TextView
                android:id="@+id/btnUninstall"
                style="@style/Widget.Androdash.DialogButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_card_height"
                android:text="Uninstall" />

            <TextView
                android:id="@+id/btnAppInfo"
                style="@style/Widget.Androdash.DialogButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_card_height"
                android:text="App Info" />

            <TextView
                android:id="@+id/btnAddToFolder"
                style="@style/Widget.Androdash.DialogButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_card_height"
                android:text="Add to Folder"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnCancel"
                style="@style/Widget.Androdash.DialogButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_card_height"
                android:text="Close" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
