<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <TextView
        android:id="@+id/bookmarkDialogTitle"
        style="@style/Widget.Androdash.DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dialog_section_spacing"
        android:text="Add Bookmark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:divider="@drawable/divider_spacing"
        android:showDividers="middle">

        <EditText
            android:id="@+id/bookmarkLabel"
            style="@style/Widget.Androdash.DialogInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_card_height"
            android:hint="Label"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:divider="@drawable/divider_spacing"
            android:showDividers="middle">

            <ImageView
                android:id="@+id/bookmarkIconPreview"
                android:layout_width="@dimen/app_icon_size"
                android:layout_height="@dimen/app_icon_size"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/btnPickImage"
                style="@style/Widget.Androdash.DialogButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/app_card_height"
                android:layout_weight="1"
                android:text="Choose Image" />

        </LinearLayout>

        <EditText
            android:id="@+id/bookmarkUrl"
            style="@style/Widget.Androdash.DialogInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_card_height"
            android:hint="https://..."
            android:inputType="textUri" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_section_spacing"
        android:orientation="horizontal"
        android:divider="@drawable/divider_spacing"
        android:showDividers="middle">

        <TextView
            android:id="@+id/btnBookmarkCancel"
            style="@style/Widget.Androdash.DialogButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_card_height"
            android:layout_weight="1"
            android:text="Cancel" />

        <TextView
            android:id="@+id/btnBookmarkSave"
            style="@style/Widget.Androdash.DialogButton.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_card_height"
            android:layout_weight="1"
            android:text="Save" />

    </LinearLayout>

</LinearLayout>
