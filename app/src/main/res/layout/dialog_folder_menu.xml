<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <include layout="@layout/dialog_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:divider="@drawable/divider_spacing"
        android:showDividers="middle">

        <TextView
            android:id="@+id/btnEditFolder"
            style="@style/Widget.Androdash.DialogButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_card_height"
            android:text="Edit" />

        <TextView
            android:id="@+id/btnDeleteFolder"
            style="@style/Widget.Androdash.DialogButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_card_height"
            android:text="Delete" />

        <TextView
            android:id="@+id/btnCancelFolder"
            style="@style/Widget.Androdash.DialogButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_card_height"
            android:text="Cancel" />

    </LinearLayout>

</LinearLayout>
