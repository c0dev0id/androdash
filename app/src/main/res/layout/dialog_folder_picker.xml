<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <TextView
        style="@style/Widget.Androdash.DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dialog_section_spacing"
        android:text="Add to Folder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:divider="@drawable/divider_spacing"
        android:showDividers="middle">

        <!-- Weighted so the list shrinks and scrolls before the dialog outgrows the screen. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/folderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="@drawable/divider_spacing"
                android:showDividers="middle" />

        </ScrollView>

        <TextView
            android:id="@+id/btnFolderPickerCancel"
            style="@style/Widget.Androdash.DialogButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_card_height"
            android:text="Cancel" />

    </LinearLayout>

</LinearLayout>
